{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Model ready",
      "targets": [{"expr": "recommendation_model_ready", "refId": "A"}],
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "targets": [{"expr": "sum(rate(recommendation_http_requests_total[5m])) by (status)", "legendFormat": "{{status}}", "refId": "A"}],
      "gridPos": {"h": 7, "w": 9, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(recommendation_http_request_duration_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}", "refId": "A"}],
      "gridPos": {"h": 7, "w": 9, "x": 15, "y": 0}
    },
    {
      "type": "bargauge",
      "title": "Recommended products",
      "targets": [{"expr": "topk(10, sum(recommendation_products_returned_total) by (product))", "legendFormat": "{{product}}", "refId": "A"}],
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 7}
    }
  ],
